{
  "name": "@replayablejs/devtools",
  "version": "0.1.0-alpha.3",
  "description": "Renderer-independent development tools for Replayable playables",
  "homepage": "https://github.com/replayablejs/replayable#readme",
  "bugs": {
    "url": "https://github.com/replayablejs/replayable/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/replayablejs/replayable.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#types/*": "./src/types/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-scale": "catalog:",
    "d3-shape": "catalog:"
  },
  "devDependencies": {
    "@replayablejs/runtime": "workspace:*",
    "@tsdown/css": "catalog:",
    "@types/d3-scale": "catalog:",
    "@types/d3-shape": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "sass-embedded": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@replayablejs/runtime": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
